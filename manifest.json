{
	"name": "Forget till - Snooze Tabs & Windows for later",
	"short_name": "Forget till",
	"description": "Declutter your browser by snoozing tabs and windows until you actually need them.",
	"version": "1.0",
	
	"icons": {
		"128": "icons/logo-128.png",
		"48": "icons/logo-48.png",
		"32": "icons/logo-32.png",
		"16": "icons/logo-16.png"
	},
	"manifest_version": 2,
	"browser_action": {
		"default_popup": "html/popup.html"
	},
	"author": "Tygas inspired by Rohan Bhansali",
	"options_ui": {
		"page": "html/settings.html",
		"open_in_tab": true
	},
	
	"background": {
		"scripts": ["scripts/dayjs.min.js", "scripts/common.js", "scripts/poll.js", "scripts/background.js"]
	},
	"offline_enabled": true,

	"permissions": ["alarms", "contextMenus", "idle", "notifications", "storage", "tabs", "https://habitica.com/*", "bookmarks"],

	"web_accessible_resources": ["html/settings.html"],

	"content_scripts": [{
		"matches": ["https://*.snoozz.me/*"],
		"js": ["scripts/snoozz.me.js"]
	}],

	"commands": {
		"nap-room": {
			"description": "Show me my sleeping tabs"
		},
		"startup": {
			"description": "Snooze until the next time you launch your browser"
		},
		"in-an-hour": {
			"description": "Snooze for an hour"
		},
		"today-morning": {
			"description": "Snooze till today morning"
		},
		"today-evening": {
			"description": "Snooze till today evening"
		},
		"tom-morning": {
			"description": "Snooze till tomorrow morning"
		},
		"tom-evening": {
			"description": "Snooze till tomorrow evening"
		},
		"weekend": {
			"description": "Snooze till this Saturday"
		},
		"monday": {
			"description": "Snooze till next Monday"
		},
		"week": {
			"description": "Snooze till one week from now"
		},
		"month": {
			"description": "Snooze till one month from now"
		},
		"bookmark-1": {"description": "Open bookmark 1"},
		"bookmark-2": {"description": "Open bookmark 2"},
		"bookmark-3": {"description": "Open bookmark 3"},
		"bookmark-4": {"description": "Open bookmark 4"},
		"bookmark-5": {"description": "Open bookmark 5"},
		"bookmark-6": {"description": "Open bookmark 6"},
		"bookmark-7": {"description": "Open bookmark 7"},
		"bookmark-8": {"description": "Open bookmark 8"},
		"bookmark-9": {"description": "Open bookmark 9"},
		"bookmark-10": {"description": "Open bookmark 10"}
	}
}
