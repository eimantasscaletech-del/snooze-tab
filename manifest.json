{
	"name": "Postpone tab to later",
	"short_name": "Postpone tab",
	"description": "Move distractions and DO IT LATER tabs to later",
	"version": "1.5",
	"icons": {
		"128": "icons/ext-icon-128.png",
		"16": "icons/ext-icon-16.png"
	},
	"manifest_version": 3,
	"action": {
		"default_icon": {
			"128": "icons/ext-icon-128.png",
			"16": "icons/ext-icon-16.png"
		},
		"default_popup": "html/popup.html"
	},
	"author": "Tygas inspired by Rohan Bhansali",
	"options_ui": {
		"page": "html/settings.html",
		"open_in_tab": true
	},
	"background": {
		"service_worker": "scripts/service-worker.js"
	},
	"offline_enabled": true,
	"permissions": [
		"alarms",
		"contextMenus",
		"idle",
		"notifications",
		"storage",
		"tabs",
		"bookmarks",
		"identity",
		"offscreen"
	],
	"host_permissions": [
		"https://habitica.com/*",
		"https://www.googleapis.com/*",
		"https://stats.snoozz.me/*"
	],
	"oauth2": {
		"client_id": "232211191249-b5dv27oncbka7epqsl7eclmfqno0tsk1.apps.googleusercontent.com",
		"scopes": [
			"https://www.googleapis.com/auth/calendar.readonly"
		]
	},
	"web_accessible_resources": [
		{
			"resources": [
				"html/settings.html"
			],
			"matches": [
				"<all_urls>"
			]
		}
	],
	"content_scripts": [
		{
			"matches": [
				"https://*.snoozz.me/*"
			],
			"js": [
				"scripts/snoozz.me.js"
			]
		}
	],
	"commands": {
		"nap-room": {
			"description": "Show me my sleeping tabs"
		},
		"startup": {
			"description": "Snooze until the next time you launch your browser"
		},
		"in-an-hour": {
			"description": "Snooze for an hour"
		},
		"today-morning": {
			"description": "Snooze till today morning"
		},
		"today-evening": {
			"description": "Snooze till today evening"
		},
		"tom-morning": {
			"description": "Snooze till tomorrow morning"
		},
		"tom-evening": {
			"description": "Snooze till tomorrow evening"
		},
		"weekend": {
			"description": "Snooze till this Saturday"
		},
		"monday": {
			"description": "Snooze till next Monday"
		},
		"week": {
			"description": "Snooze till one week from now"
		},
		"month": {
			"description": "Snooze till one month from now"
		},
		"bookmark-1": {
			"description": "Open bookmark 1"
		},
		"bookmark-2": {
			"description": "Open bookmark 2"
		},
		"bookmark-3": {
			"description": "Open bookmark 3"
		},
		"bookmark-4": {
			"description": "Open bookmark 4"
		},
		"bookmark-5": {
			"description": "Open bookmark 5"
		},
		"bookmark-6": {
			"description": "Open bookmark 6"
		},
		"bookmark-7": {
			"description": "Open bookmark 7"
		},
		"bookmark-8": {
			"description": "Open bookmark 8"
		},
		"bookmark-9": {
			"description": "Open bookmark 9"
		},
		"bookmark-10": {
			"description": "Open bookmark 10"
		}
	}
}
